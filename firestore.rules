rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['GANTI_DENGAN_EMAIL_ADMIN'];
    }
    // Ucapan publik: siapa pun dapat melihat yang belum kedaluwarsa.
    match /publicMessages/{id} {
      allow read: if resource.data.expiresAt > request.time;
      allow create: if request.resource.data.keys().hasOnly(['name','message','createdAt','expiresAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(1, 'm');
      allow update, delete: if isAdmin();
    }
    // Data RSVP lengkap, daftar tamu dan amplop hanya admin.
    match /rsvps/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','attendance','count','message','guestCode','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 5
        && request.resource.data.attendance in ['Hadir','Belum pasti','Tidak hadir'];
      allow read, update, delete: if isAdmin();
    }
    match /guestList/{id} {
      allow read, write: if isAdmin();
    }
    match /envelopes/{id} {
      allow read, write: if isAdmin();
    }
  }
}